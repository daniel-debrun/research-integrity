{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --locked --quiet --project \"${CLAUDE_PLUGIN_ROOT}/server\" research-ledger --digest",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/server/src/research_ledger/guard_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
